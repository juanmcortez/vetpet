includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 6

    ignoreErrors:
        - message: '#Trait App\\Models\\Concerns\\BelongsToClinic is used zero times#'
